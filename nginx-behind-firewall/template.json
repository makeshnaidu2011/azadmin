{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources. Create the resource group in a region that supports Azure Firewall and Bastion."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "nginx"
    },
    "adminSshPublicKey": {
      "type": "secureString",
      "metadata": {
        "description": "SSH public key used to access the Linux VM."
      }
    },
    "publicIPAddresses_nat_pip_name": {
      "type": "string",
      "defaultValue": "nat-pip"
    },
    "virtualNetworks_demo_vnet_name": {
      "type": "string",
      "defaultValue": "demo-vnet"
    },
    "natGateways_demo_natagetway_name": {
      "type": "string",
      "defaultValue": "demo-natgateway"
    },
    "virtualMachines_demo_vm_nginix_name": {
      "type": "string",
      "defaultValue": "demo-vm-nginx"
    },
    "bastionHosts_demo_vnet_Bastion_name": {
      "type": "string",
      "defaultValue": "demo-vnet-Bastion"
    },
    "azureFirewalls_demo_vnet_Firewall_name": {
      "type": "string",
      "defaultValue": "demo-vnet-Firewall"
    },
    "networkInterfaces_demo_vm_nginix604_name": {
      "type": "string",
      "defaultValue": "demo-vm-nginx-nic"
    },
    "publicIPAddresses_demo_vnet_bastion_name": {
      "type": "string",
      "defaultValue": "demo-vnet-bastion-pip"
    },
    "publicIPAddresses_demo_vnet_firewall_name": {
      "type": "string",
      "defaultValue": "demo-vnet-firewall-pip"
    },
    "networkSecurityGroups_demo_vm_nginix_nsg_name": {
      "type": "string",
      "defaultValue": "demo-vm-nginx-nsg"
    },
    "firewallPolicies_FirewallPolicy_demo_vnet_Firewall_name": {
      "type": "string",
      "defaultValue": "FirewallPolicy-demo-vnet-Firewall"
    }
  },
  "variables": {
    "networkApiVersion": "2024-05-01",
    "computeApiVersion": "2024-11-01",
    "appSubnetName": "demo-subnet-app",
    "appSubnetPrefix": "10.0.0.0/24",
    "bastionSubnetName": "AzureBastionSubnet",
    "bastionSubnetPrefix": "10.0.1.0/26",
    "firewallSubnetName": "AzureFirewallSubnet",
    "firewallSubnetPrefix": "10.0.1.64/26",
    "vmPrivateIp": "10.0.0.4"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[parameters('networkSecurityGroups_demo_vm_nginix_nsg_name')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-HTTP-Inbound",
            "properties": {
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "80",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 300,
              "direction": "Inbound"
            }
          },
          {
            "name": "Allow-SSH-From-Bastion",
            "properties": {
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "22",
              "sourceAddressPrefix": "[variables('bastionSubnetPrefix')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 310,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[parameters('publicIPAddresses_nat_pip_name')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAddressVersion": "IPv4",
        "publicIPAllocationMethod": "Static",
        "idleTimeoutInMinutes": 4
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[parameters('publicIPAddresses_demo_vnet_bastion_name')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAddressVersion": "IPv4",
        "publicIPAllocationMethod": "Static",
        "idleTimeoutInMinutes": 4
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[parameters('publicIPAddresses_demo_vnet_firewall_name')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAddressVersion": "IPv4",
        "publicIPAllocationMethod": "Static",
        "idleTimeoutInMinutes": 4
      }
    },
    {
      "type": "Microsoft.Network/firewallPolicies",
      "apiVersion": "2024-05-01",
      "name": "[parameters('firewallPolicies_FirewallPolicy_demo_vnet_Firewall_name')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "tier": "Standard"
        },
        "threatIntelMode": "Alert"
      }
    },
    {
      "type": "Microsoft.Network/natGateways",
      "apiVersion": "2024-05-01",
      "name": "[parameters('natGateways_demo_natagetway_name')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_nat_pip_name'))]"
      ],
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "idleTimeoutInMinutes": 4,
        "publicIpAddresses": [
          {
            "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_nat_pip_name'))]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[parameters('virtualNetworks_demo_vnet_name')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/natGateways', parameters('natGateways_demo_natagetway_name'))]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "[variables('appSubnetName')]",
            "properties": {
              "addressPrefix": "[variables('appSubnetPrefix')]",
              "natGateway": {
                "id": "[resourceId('Microsoft.Network/natGateways', parameters('natGateways_demo_natagetway_name'))]"
              },
              "privateEndpointNetworkPolicies": "Disabled",
              "privateLinkServiceNetworkPolicies": "Enabled"
            }
          },
          {
            "name": "[variables('bastionSubnetName')]",
            "properties": {
              "addressPrefix": "[variables('bastionSubnetPrefix')]",
              "privateEndpointNetworkPolicies": "Disabled",
              "privateLinkServiceNetworkPolicies": "Enabled"
            }
          },
          {
            "name": "[variables('firewallSubnetName')]",
            "properties": {
              "addressPrefix": "[variables('firewallSubnetPrefix')]",
              "privateEndpointNetworkPolicies": "Disabled",
              "privateLinkServiceNetworkPolicies": "Enabled"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/firewallPolicies/ruleCollectionGroups",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/DefaultDnatRuleCollectionGroup', parameters('firewallPolicies_FirewallPolicy_demo_vnet_Firewall_name'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/firewallPolicies', parameters('firewallPolicies_FirewallPolicy_demo_vnet_Firewall_name'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_demo_vnet_firewall_name'))]"
      ],
      "properties": {
        "priority": 100,
        "ruleCollections": [
          {
            "name": "nginx-dnat",
            "ruleCollectionType": "FirewallPolicyNatRuleCollection",
            "priority": 200,
            "action": {
              "type": "Dnat"
            },
            "rules": [
              {
                "name": "nginx-port-4000",
                "ruleType": "NatRule",
                "ipProtocols": [
                  "TCP"
                ],
                "sourceAddresses": [
                  "*"
                ],
                "destinationAddresses": [
                  "[reference(resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_demo_vnet_firewall_name')), variables('networkApiVersion')).ipAddress]"
                ],
                "destinationPorts": [
                  "4000"
                ],
                "translatedAddress": "[variables('vmPrivateIp')]",
                "translatedPort": "80"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/bastionHosts",
      "apiVersion": "2024-05-01",
      "name": "[parameters('bastionHosts_demo_vnet_Bastion_name')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_demo_vnet_bastion_name'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworks_demo_vnet_name'))]"
      ],
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "ipConfigurations": [
          {
            "name": "IpConf",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_demo_vnet_bastion_name'))]"
              },
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworks_demo_vnet_name'), variables('bastionSubnetName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/azureFirewalls",
      "apiVersion": "2024-05-01",
      "name": "[parameters('azureFirewalls_demo_vnet_Firewall_name')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_demo_vnet_firewall_name'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworks_demo_vnet_name'))]",
        "[resourceId('Microsoft.Network/firewallPolicies', parameters('firewallPolicies_FirewallPolicy_demo_vnet_Firewall_name'))]"
      ],
      "properties": {
        "sku": {
          "name": "AZFW_VNet",
          "tier": "Standard"
        },
        "firewallPolicy": {
          "id": "[resourceId('Microsoft.Network/firewallPolicies', parameters('firewallPolicies_FirewallPolicy_demo_vnet_Firewall_name'))]"
        },
        "ipConfigurations": [
          {
            "name": "ipConfig",
            "properties": {
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_demo_vnet_firewall_name'))]"
              },
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworks_demo_vnet_name'), variables('firewallSubnetName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "[parameters('networkInterfaces_demo_vm_nginix604_name')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworks_demo_vnet_name'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('networkSecurityGroups_demo_vm_nginix_nsg_name'))]"
      ],
      "properties": {
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('networkSecurityGroups_demo_vm_nginix_nsg_name'))]"
        },
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAddress": "[variables('vmPrivateIp')]",
              "privateIPAllocationMethod": "Static",
              "privateIPAddressVersion": "IPv4",
              "primary": true,
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworks_demo_vnet_name'), variables('appSubnetName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-11-01",
      "name": "[parameters('virtualMachines_demo_vm_nginix_name')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', parameters('networkInterfaces_demo_vm_nginix604_name'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_D2s_v3"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "name": "[format('{0}-osdisk', parameters('virtualMachines_demo_vm_nginix_name'))]",
            "osType": "Linux",
            "createOption": "FromImage",
            "caching": "ReadWrite",
            "deleteOption": "Delete",
            "diskSizeGB": 30,
            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          }
        },
        "osProfile": {
          "computerName": "[parameters('virtualMachines_demo_vm_nginix_name')]",
          "adminUsername": "[parameters('adminUsername')]",
          "customData": "[base64('#cloud-config\npackage_update: true\npackages:\n  - nginx\nruncmd:\n  - systemctl enable nginx\n  - systemctl restart nginx\n')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "provisionVMAgent": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",
                  "keyData": "[parameters('adminSshPublicKey')]"
                }
              ]
            },
            "patchSettings": {
              "patchMode": "ImageDefault",
              "assessmentMode": "ImageDefault"
            }
          }
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('networkInterfaces_demo_vm_nginix604_name'))]",
              "properties": {
                "primary": true,
                "deleteOption": "Delete"
              }
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      }
    }
  ],
  "outputs": {
    "firewallPublicIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_demo_vnet_firewall_name')), variables('networkApiVersion')).ipAddress]"
    },
    "nginxUrl": {
      "type": "string",
      "value": "[format('http://{0}:4000', reference(resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIPAddresses_demo_vnet_firewall_name')), variables('networkApiVersion')).ipAddress)]"
    },
    "vmPrivateIp": {
      "type": "string",
      "value": "[variables('vmPrivateIp')]"
    }
  }
}
